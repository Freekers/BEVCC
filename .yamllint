extends: default

ignore: |
  .venv/
  ci-config/

rules:
  line-length:
    max: 160
    # Markdown-kaarten in het dashboard: lange regels in de kaarttekst zijn bedoeld
    ignore: |
      dashboard/
  document-start: disable
  truthy:
    allowed-values: ["true", "false"]
    check-keys: false
  comments:
    min-spaces-from-content: 1
  comments-indentation: disable
